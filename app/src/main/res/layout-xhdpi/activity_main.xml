<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorPrimary"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/iconeDolar"
        android:layout_width="132dp"
        android:layout_height="133dp"
        android:layout_marginStart="88dp"
        app:layout_constraintBottom_toBottomOf="@+id/valorConta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/valorConta"
        app:layout_constraintVertical_bias="0.44"
        app:srcCompat="@drawable/icons8_dollar_80" />

    <EditText
        android:id="@+id/valorConta"
        android:layout_width="463dp"
        android:layout_height="74dp"
        android:layout_marginTop="280dp"
        android:ems="10"
        android:hint="@string/hintValorConta"
        android:inputType="numberDecimal"
        android:textSize="34sp"
        android:textStyle="italic"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.222"
        app:layout_constraintStart_toEndOf="@+id/iconeDolar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.187" />

    <ImageView
        android:id="@+id/iconePessoa"
        android:layout_width="155dp"
        android:layout_height="144dp"
        android:layout_marginStart="76dp"
        app:layout_constraintBottom_toBottomOf="@+id/qtdPessoa"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/qtdPessoa"
        app:layout_constraintVertical_bias="0.391"
        app:srcCompat="@drawable/icons8_person_96" />

    <EditText
        android:id="@+id/qtdPessoa"
        android:layout_width="463dp"
        android:layout_height="75dp"
        android:layout_marginTop="116dp"
        android:ems="10"
        android:hint="@string/hintQtdPessoa"
        android:inputType="number"
        android:textSize="34sp"
        android:textStyle="italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.141"
        app:layout_constraintStart_toEndOf="@+id/iconePessoa"
        app:layout_constraintTop_toBottomOf="@+id/valorConta" />

    <TextView
        android:id="@+id/perPessoa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="164dp"
        android:textAlignment="center"
        android:textSize="50sp"
        android:textStyle="bold|italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.523"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/qtdPessoa" />

    <ImageButton
        android:id="@+id/imageButton4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="172dp"
        android:backgroundTint="#00FFFFFF"
        app:layout_constraintBottom_toBottomOf="@+id/btnSom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnSom"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/icons8_partilhar_128" />

    <ImageButton
        android:id="@+id/btnSom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="168dp"
        android:layout_marginTop="104dp"
        android:backgroundTint="#00FFFFFF"
        android:onClick="clickFale"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/perPessoa"
        app:srcCompat="@drawable/_891017_audio_circle_music_sound_speaker_icon" />

    <ImageView
        android:id="@+id/imagemPrincipal1"
        android:layout_width="219dp"
        android:layout_height="128dp"
        android:layout_marginTop="72dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.378"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vamos_rachar" />

    <TextView
        android:id="@+id/appTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="188dp"
        android:text="@string/app_name"
        android:textAlignment="center"
        android:textSize="50sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.531"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imagemPrincipal2"
        android:layout_width="206dp"
        android:layout_height="108dp"
        android:layout_marginTop="260dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.673"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vamos_rachar___copia" />

</androidx.constraintlayout.widget.ConstraintLayout>